DEBUG=True
SECRET_KEY=
CSRF_TRUSTED_ORIGINS=


# --- Payments (Razorpay) ------------------------------------------------
PAYMENT_GATEWAY=razorpay
PAYMENT_CURRENCY=
# Razorpay Dashboard > Account & Settings > API Keys. Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you choose when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=


# --- Database -----------------------------------------------------------
# Leave empty to use local SQLite. Set a PostgreSQL URL in production.
DATABASE_URL=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=